# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional: pin a model (Settings lists what your key can reach)
# GEMINI_MODEL=gemini-flash-latest

# Shared password for the gate.
# Unset locally, the app is open. On a deployment it is REQUIRED: without it
# every visitor would be spending your Gemini key, so the app locks itself.
# APP_PASSWORD=pick-something-long

# --- Progress sync (optional) -------------------------------------------
# Leave these unset and the app works exactly as before, entirely in the
# browser. Set them and your place in each book follows you between devices.
#
# Supabase project settings -> Data API -> Project URL
# SUPABASE_URL=https://your-project-ref.supabase.co
#
# Supabase project settings -> API Keys -> service_role (SECRET).
# Never expose this one to the browser; only route handlers use it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
#
# Run supabase/schema.sql once in the Supabase SQL editor before using sync.
#
# Supabase pauses a free project after about a week idle, so vercel.json runs
# a daily keep-alive. Set this to any long random string and Vercel sends it
# as a bearer token, which is what stops the endpoint being public.
# CRON_SECRET=another-long-random-string
#
# Optional: separate shelves for separate readers sharing one deployment.
# SYNC_PROFILE=default
